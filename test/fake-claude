#!/bin/bash
# Test double for `claude -p --output-format json …` (only for test/test_autopilot.sh).
# The prompt comes as an argument or via stdin (claude_run always uses stdin).
# Controlled via $FAKE_DIR: steps/<n>.sh (worker runs), verdicts (one line per review: "VERDICT: ACCEPT",
# "VERDICT: REJECT: <reason>" or the structured answer itself as JSON), review-note (note of every review),
# setup.txt, planner.txt, idea.txt, spec.txt, size-<k>.txt, final-<k>.txt (fixed answers; reviewer, planner and final review answers are turned
# into the structured answer of --json-schema: task lines, "NOT REACHABLE: …", "FINAL: OK", did:/problem:/hint: lines),
# garbage (raw non-JSON output for the setup call), review-sleep (seconds the reviewer
# waits before answering; brief-sleep the same for the brief), limit.txt (every call answers with this usage-limit error), budget/<n> (worker run n
# stops at the per-call budget; like the CLI, .usage then says 0 and .modelUsage has the tokens), final-budget (the next N
# final reviews stop at the budget), api-errors (the next N calls end with an overloaded API error), steps/t<N>.sh (task N, see below).
# Every call appends "<role> env=<CLAUDE_CODE_EFFORT_LEVEL or unset> <arguments>" to args.
# Every answer costs 0.01 USD and 100/1000/10 tokens.
d=$FAKE_DIR
# `claude --help`: the pre-flight check looks for its flags; FAKE_OLD_CLAUDE=1 plays an older CLI without them,
# FAKE_MISSING=<flag> one without that flag
[ "${1:-}" = --help ] && { [ -n "${FAKE_OLD_CLAUDE:-}" ] || printf '  --safe-mode   Start with all customizations disabled\n  --effort <level>\n  --max-budget-usd <amount>\n  --json-schema <schema>\n' |
    grep -vF -- "${FAKE_MISSING:-(none)}"; echo "  --version"; exit 0; }
args="$*"; role=worker
prompt=''
for a in "$@"; do case "$a" in -p|--output-format|json) ;; --*) break ;; *) prompt=$a; break ;; esac; done
[ -n "$prompt" ] || prompt=$(cat)

count() { local n=$(( $(cat "$d/$1" 2>/dev/null || echo 0) + 1 )); echo $n >"$d/$1"; echo $n; }
log_args() { printf '%s env=%s %s\n' "$role" "${CLAUDE_CODE_EFFORT_LEVEL-unset}" "$args" >>"$d/args"; }
answer() { # TEXT [STRUCTURED]; a step may write $FAKE_DIR/denied (one command per line): reported as refused tool calls
    local s=${2:-null}; [[ " $args " == *" --json-schema "* ]] || s=null  # structured output only when asked for
    log_args
    jq -n --arg r "$1" --argjson s "$s" --arg d "$(cat "$d/denied" 2>/dev/null)" '{type: "result", is_error: false, result: $r, structured_output: $s, total_cost_usd: 0.01, usage: {input_tokens: 100, cache_read_input_tokens: 1000, output_tokens: 10},
        permission_denials: [$d | split("\n")[] | select(. != "") | {tool_name: "Bash", tool_input: {command: .}}]}'
    rm -f "$d/denied"; }
# The structured answer a model would give for a text fixture (null: no usable answer)
structured() { # ROLE TEXT [NOTE-TEXT]
    jq -n --arg role "$1" --arg t "$2" --arg n "${3-$2}" '
      ([$n | splits("\n") | capture("^(?<k>did|problem|hint): ?(?<v>.*)$")] | map({(.k): .v}) | add // {did: "none", problem: "none", hint: "none"}) as $note
      | [$t | splits("\n") | select(test("^- \\[ \\] "))] as $tasks
      | if $role == "reviewer" then
          if ($t | test("^VERDICT: ACCEPT$")) then {verdict: "accept", reasons: [], note: $note}
          elif ($t | test("^VERDICT: REJECT: ")) then {verdict: "reject", reasons: [$t | sub("^VERDICT: REJECT: "; "")], note: $note}
          else null end
        elif $role == "final" then
          if ($t | test("(^|\n)FINAL: OK")) then {ok: true, tasks: [], note: $note}
          elif ($tasks | length) > 0 then {ok: false, tasks: $tasks, note: $note} else null end
        else ([$t | splits("\n") | select(startswith("NOT REACHABLE: ")) | sub("^NOT REACHABLE: "; "")] | first) as $nr
          | if $nr then {tasks: [], not_reachable: $nr, note: $note} else {tasks: $tasks, note: $note} end
        end'
}

# $FAKE_DIR/error.txt: every call fails like a logged-out or offline claude (error answer, exit 1)
[ -f "$d/error.txt" ] && { jq -n --arg r "$(cat "$d/error.txt")" '{type: "result", is_error: true, result: $r, total_cost_usd: 0}'; exit 1; }
[ -f "$d/limit.txt" ] && { jq -n --arg r "$(cat "$d/limit.txt")" '{type: "result", is_error: true, result: $r, total_cost_usd: 0}'; exit 1; }
if [ "$(cat "$d/api-errors" 2>/dev/null || echo 0)" -gt 0 ]; then
    echo $(( $(cat "$d/api-errors") - 1 )) >"$d/api-errors"
    jq -n '{type: "result", is_error: true, api_error_status: 529, result: "API Error: 529 {\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}", total_cost_usd: 0}'; exit 1
fi

case "$prompt" in
    # lessons.txt: the answer of every lessons run (default: an empty list); final-<k>.txt: the k-th final review (default OK)
    *"You are condensing the lessons"*) role=lessons; count lessons-nr >/dev/null; printf '%s\n' "$prompt" >"$d/lessons-prompt"
        answer "$(cat "$d/lessons.txt" 2>/dev/null || printf '<<<LESSONS\nLESSONS>>>')" ;;
    *"You are the final reviewer"*) role=final
        if [ "$(cat "$d/final-budget" 2>/dev/null || echo 0)" -gt 0 ]; then
            echo $(( $(cat "$d/final-budget") - 1 )) >"$d/final-budget"; log_args
            jq -n '{type: "result", subtype: "error_max_budget_usd", is_error: true, result: null, errors: ["Reached maximum budget"], total_cost_usd: 0.01}'; exit 1
        fi
        k=$(count final-nr); printf '%s\n' "$prompt" >"$d/final-prompt"; cp "$d/final-prompt" "$d/final-prompt-$k"
        t=$(cat "$d/final-$k.txt" 2>/dev/null || echo 'FINAL: OK'); answer "$t" "$(structured final "$t")" ;;
    *"You are the reviewer"*) role=reviewer; [ -f "$d/review-sleep" ] && sleep "$(cat "$d/review-sleep")"
        if [ "$(cat "$d/review-budget" 2>/dev/null || echo 0)" -gt 0 ]; then  # review-budget: the next N reviews stop at the budget
            echo $(( $(cat "$d/review-budget") - 1 )) >"$d/review-budget"; log_args
            jq -n '{type: "result", subtype: "error_max_budget_usd", is_error: true, result: null, errors: ["Reached maximum budget"], total_cost_usd: 5.01}'; exit 1
        fi
        v=$(sed -n "$(count verdict-nr)p" "$d/verdicts" 2>/dev/null)  # no verdicts file: an answer without a verdict
        case $v in '{'*) s=$v ;; *) s=$(structured reviewer "$v" "$(cat "$d/review-note" 2>/dev/null)") ;; esac
        answer "Reasoning … $v" "$s" ;;
    *"You are setting up an autopilot"*) role=draft; printf '%s\n' "$prompt" >"$d/setup-prompt"; if [ -f "$d/garbage" ]; then cat "$d/garbage"; else answer "$(cat "$d/setup.txt")"; fi ;;
    *"You are the planner"*) role=planner; printf '%s\n' "$prompt" >"$d/planner-prompt"; t=$(cat "$d/planner.txt"); answer "$t" "$(structured planner "$t")" ;;
    # size-<k>.txt: task lines of the k-th size check = does not fit, split into them (default: fits)
    *"You are sizing a task"*) role=size; k=$(count size-nr); printf '%s\n' "$prompt" >"$d/size-prompt"; t=$(cat "$d/size-$k.txt" 2>/dev/null)
        answer "$t" "$(jq -n --arg t "$t" '[$t | splits("\n") | select(test("^- \\[ \\] "))] | {fits: (length == 0), split: .}')" ;;
    *"You are writing a specification"*) role=spec; printf '%s\n' "$prompt" >"$d/spec-prompt"; answer "$(cat "$d/spec.txt")" ;;
    *"You are turning a rough idea"*) role=plan; printf '%s\n' "$prompt" >"$d/idea-prompt"; answer "$(cat "$d/idea.txt")" ;;
    *"You are writing the brief"*) role=brief; [ -f "$d/brief-sleep" ] && sleep "$(cat "$d/brief-sleep")"; count brief-nr >/dev/null; printf '%s\n' "$prompt" >"$d/brief-prompt"; answer "BRIEF: reuse check.sh, add one check line" ;;
    # steps/t<N>-<k>.sh: the k-th run of task N, steps/t<N>.sh: every run of it (parallel workers, whatever their order);
    # otherwise steps/<n>.sh for the n-th worker run. prompt-t<N>: the last prompt for task N.
    *)  t=$(sed -nE 's/^Your task \(the script picked it, line [0-9]+ of .*\): - \[ \] ([0-9][0-9.]*)\..*/\1/p' <<<"$prompt" | head -1)
        if [ -n "$t" ] && compgen -G "$d/steps/t$t[-.]*" >/dev/null; then
            k=$(count "task-$t-nr"); n=t$t-$k; [ -f "$d/steps/$n.sh" ] || [ ! -f "$d/steps/t$t.sh" ] || cp "$d/steps/t$t.sh" "$d/steps/$n.sh"; printf '%s\n' "$prompt" >"$d/prompt-t$t"
        else n=$(count step-nr); fi
        printf '%s\n' "$prompt" >"$d/last-prompt"
        grep -q "## Feedback on the previous attempt" <<<"$prompt" && echo "$n" >>"$d/with-feedback"
        grep -q "## Plan being implemented" <<<"$prompt" && echo "$n" >>"$d/with-plan"
        grep -q "DECISIONS.md" <<<"$prompt" && echo "$n" >>"$d/with-decisions"
        [ -f "$d/steps/$n.sh" ] || { answer "no steps left"; exit 1; }
        bash "$d/steps/$n.sh"; [ $? = 124 ] && exit 124  # step simulates the time limit
        if [ -f "$d/budget/$n" ]; then  # the run stops at --max-budget-usd after its changes
            log_args; jq -n '{type: "result", subtype: "error_max_budget_usd", is_error: true, result: null, errors: ["Reached maximum budget ($2)"], total_cost_usd: 2.01,
                usage: {input_tokens: 0, cache_read_input_tokens: 0, output_tokens: 0, cache_creation_input_tokens: 0},
                modelUsage: {"claude-a": {inputTokens: 2, cacheReadInputTokens: 300, outputTokens: 40, cacheCreationInputTokens: 50}, "claude-b": {inputTokens: 1, cacheReadInputTokens: 0, outputTokens: 2, cacheCreationInputTokens: 5}}}'; exit 1
        fi
        answer "Step $n done$([ -f "$d/notes/$n" ] && printf '\n%s' "$(cat "$d/notes/$n")")" ;;  # notes/<n>: appended to the answer
esac
