#!/bin/bash
# Test double for `claude -p --output-format json …` (only for test/test_autopilot.sh).
# The prompt comes as an argument or via stdin (claude_run always uses stdin).
# Controlled via $FAKE_DIR: steps/<n>.sh (worker runs), verdicts (one line per review),
# setup.txt, planner.txt, report.txt (fixed answers), garbage (raw non-JSON output for the setup call), review-sleep (seconds the reviewer waits before answering). Every answer costs 0.01 USD.
d=$FAKE_DIR
# `claude --help`: the pre-flight check looks for --safe-mode; FAKE_OLD_CLAUDE=1 plays an older CLI without it
[ "${1:-}" = --help ] && { [ -n "${FAKE_OLD_CLAUDE:-}" ] || echo "  --safe-mode   Start with all customizations disabled"; echo "  --version"; exit 0; }
prompt=''
for a in "$@"; do case "$a" in -p|--output-format|json) ;; --*) break ;; *) prompt=$a; break ;; esac; done
[ -n "$prompt" ] || prompt=$(cat)

count() { local n=$(( $(cat "$d/$1" 2>/dev/null || echo 0) + 1 )); echo $n >"$d/$1"; echo $n; }
answer() { # a step may write $FAKE_DIR/denied (one command per line): reported as refused tool calls
    jq -n --arg r "$1" --arg d "$(cat "$d/denied" 2>/dev/null)" '{type: "result", is_error: false, result: $r, total_cost_usd: 0.01,
        permission_denials: [$d | split("\n")[] | select(. != "") | {tool_name: "Bash", tool_input: {command: .}}]}'
    rm -f "$d/denied"; }

# $FAKE_DIR/error.txt: every call fails like a logged-out or offline claude (error answer, exit 1)
[ -f "$d/error.txt" ] && { jq -n --arg r "$(cat "$d/error.txt")" '{type: "result", is_error: true, result: $r, total_cost_usd: 0}'; exit 1; }

case "$prompt" in
    *"You are the reviewer"*) [ -f "$d/review-sleep" ] && sleep "$(cat "$d/review-sleep")"; answer "Reasoning …
$(sed -n "$(count verdict-nr)p" "$d/verdicts")" ;;
    *"You are setting up an autopilot"*) if [ -f "$d/garbage" ]; then cat "$d/garbage"; else answer "$(cat "$d/setup.txt")"; fi ;;
    *"You are the planner"*) answer "$(cat "$d/planner.txt")" ;;
    *"You are turning a rough idea"*) printf '%s\n' "$prompt" >"$d/idea-prompt"; answer "$(cat "$d/idea.txt")" ;;
    *"You are writing the brief"*) count brief-nr >/dev/null; answer "BRIEF: reuse check.sh, add one check line" ;;
    *"Summarise this for the project owner"*) answer "$(cat "$d/report.txt")" ;;
    *)  n=$(count step-nr); printf '%s\n' "$prompt" >"$d/last-prompt"
        grep -q "## Feedback on the previous attempt" <<<"$prompt" && echo "$n" >>"$d/with-feedback"
        grep -q "## Plan being implemented" <<<"$prompt" && echo "$n" >>"$d/with-plan"
        grep -q "DECISIONS.md" <<<"$prompt" && echo "$n" >>"$d/with-decisions"
        [ -f "$d/steps/$n.sh" ] || { answer "no steps left"; exit 1; }
        bash "$d/steps/$n.sh"; [ $? = 124 ] && exit 124  # step simulates the time limit
        answer "Step $n done" ;;
esac
